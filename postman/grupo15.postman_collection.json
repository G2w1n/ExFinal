    {
      "name": "Sesión",
      "item": [
        {
          "name": "Iniciar sesión (devuelve el token JWT)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"cliente1@correo.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "POST /auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inicio de sesión correcto', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); console.log('Token guardado para', r.usuario.correo); }"
                ]
              }
            }
          ]
        },
